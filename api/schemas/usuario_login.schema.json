{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UsuarioLogin",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 255
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 72,
      "writeOnly": true
    }
  },
  "required": ["email", "password"],
  "additionalProperties": false
}