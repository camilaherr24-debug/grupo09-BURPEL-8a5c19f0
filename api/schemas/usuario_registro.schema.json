{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UsuarioRegistro",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 255
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 72,
      "writeOnly": true
    }
  },
  "required": ["nombre", "email", "password"],
  "additionalProperties": false
}