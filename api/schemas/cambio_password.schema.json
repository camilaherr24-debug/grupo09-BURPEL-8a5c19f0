{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CambioPassword",
  "type": "object",
  "properties": {
    "password_actual": {
      "type": "string",
      "minLength": 1,
      "maxLength": 72,
      "writeOnly": true
    },
    "password_nueva": {
      "type": "string",
      "minLength": 8,
      "maxLength": 72,
      "writeOnly": true
    }
  },
  "required": ["password_actual", "password_nueva"],
  "additionalProperties": false
}